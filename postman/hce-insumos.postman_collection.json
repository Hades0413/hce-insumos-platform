{
  "info": {
    "_postman_id": "7caebced-12bd-40fc-b29e-4467ea013306",
    "name": "HCE Insumos API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección del API Gateway HCE Insumos.\n\n**Flujo**: 1) Auth › CSRF (guarda csrfToken) 2) Auth › Login (cookies HttpOnly hce_at/hce_rt quedan en el cookie jar de Postman) 3) resto de endpoints.\n\nLas escrituras envían `X-CSRF-Token`; compras/ventas generan `Idempotency-Key` automáticamente. Errores en formato RFC 7807."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Obtiene el token CSRF automáticamente si aún no existe",
          "if (!pm.collectionVariables.get('csrfToken') && !pm.request.url.toString().includes('/auth/csrf')) {",
          "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/auth/csrf', method: 'GET' }, (err, res) => {",
          "    if (!err) pm.collectionVariables.set('csrfToken', res.json().csrfToken);",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "productoId",
      "value": "1"
    },
    {
      "key": "compraId",
      "value": "1"
    },
    {
      "key": "ventaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "csrf"
              ]
            },
            "description": "Emite cookie hce_csrf (HttpOnly) y devuelve el token para el header X-CSRF-Token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login inválido → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('RFC 7807', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));",
                  "pm.collectionVariables.set('csrfToken', ''); // el CSRF está atado a la sesión: se pide uno nuevo tras login/logout"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('cookies HttpOnly emitidas', () => pm.expect(pm.cookies.has('hce_at')).to.be.true);",
                  "pm.test('sin tokens en el body', () => pm.expect(pm.response.json()).to.not.have.property('accessToken'));",
                  "pm.collectionVariables.set('csrfToken', ''); // el CSRF está atado a la sesión: se pide uno nuevo tras login/logout"
                ]
              }
            }
          ]
        },
