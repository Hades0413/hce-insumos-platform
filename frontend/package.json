{
  "name": "hce-insumos-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Frontend HCE Insumos: Next.js Multi-Zones (shell + microfronts compras/ventas/kardex)",
  "packageManager": "pnpm@11.8.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
