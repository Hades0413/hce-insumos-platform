# =============================================================================
# HCE Insumos — variables de entorno de docker-compose
# NO edites a mano para desarrollo: ejecuta ./scripts/setup.sh, que genera
# .env con secretos aleatorios fuertes y el par de claves ES256 del JWT.
# =============================================================================

# --- SQL Server (contraseñas con política de complejidad de SQL Server)
MSSQL_SA_PASSWORD=
INSUMOS_DB_PASSWORD=
AUTH_DB_PASSWORD=

# --- NATS: una credencial por servicio (permisos mínimos en infra/nats/nats.conf)
NATS_GATEWAY_PASSWORD=
NATS_AUTH_PASSWORD=
NATS_INVENTORY_PASSWORD=

# --- JWT ES256 (PEM en base64). Privada SOLO en auth-service; pública en el gateway.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# --- CSRF (HMAC)
CSRF_SECRET=

# --- Usuarios demo (admin@hce.local, almacen@hce.local, farmacia@hce.local)
# En producción: SEED_DEMO_USERS=false y SEED_DEMO_DATA=false.
SEED_DEMO_USERS=true
SEED_DEMO_DATA=true
SEED_USERS_PASSWORD=

# --- Red / URLs públicas
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api/v1
# true detrás de HTTPS (producción). En localhost por http debe ser false.
COOKIE_SECURE=false
SWAGGER_ENABLED=true
# Nº exacto de proxies inversos delante del gateway (0 = ninguno). Nunca "true".
TRUST_PROXY=0

# --- Reglas de negocio
IGV_RATE=0.18
MARGEN_VENTA=0.35

# --- Observabilidad
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=
