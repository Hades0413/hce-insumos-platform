{
  "uid": "hce-overview",
  "title": "HCE Insumos — Visión general",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries", "title": "Requests/s por ruta (gateway)", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(hce_http_request_duration_seconds_count[1m]))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Latencia p95 por ruta (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(hce_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }]
    },
    {
      "type": "timeseries", "title": "Errores 5xx/s", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(hce_http_request_duration_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "5xx" }]
    },
    {
      "type": "timeseries", "title": "Casos de uso: resultado (inventory)", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (operation, outcome) (rate(hce_operation_duration_seconds_count[5m]))", "legendFormat": "{{operation}} {{outcome}}" }]
    },
    {
      "type": "timeseries", "title": "Event loop lag p99 (s)", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max by (service) (nodejs_eventloop_lag_p99_seconds)", "legendFormat": "{{service}}" }]
    },
    {
      "type": "timeseries", "title": "Heap usado (bytes)", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (service) (nodejs_heap_size_used_bytes)", "legendFormat": "{{service}}" }]
    }
  ]
}
