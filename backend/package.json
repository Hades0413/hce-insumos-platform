{
  "name": "hce-insumos-backend",
  "version": "1.0.0",
  "description": "HCE Insumos: API Gateway + microservicios (auth, inventory) NestJS sobre NATS y SQL Server",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-service && nest build inventory-service",
    "build:app": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:inventory": "nest start inventory-service --watch",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest-e2e.config.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/microservices": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "6.8.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "joi": "18.3.2",
    "mssql": "12.7.13",
    "nats": "2.29.3",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/mssql": "12.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "^3.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "webpack": "5.112.2",
    "webpack-node-externals": "^3.0.0"
  }
}
